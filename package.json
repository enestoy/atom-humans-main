{
  "name": "atom-humans",
  "version": "0.1.0",
  "description": "Animated atom humans for React: stardust bodies and human faces, with nine expressive states. Canvas 2D, no WebGL.",
  "keywords": [
    "react",
    "human",
    "atoms",
    "particles",
    "avatar",
    "canvas",
    "animation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:site": "npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "test": "node --test tests/*.test.cjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^3.9.1"
  }
}
